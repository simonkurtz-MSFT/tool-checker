# Copy this file to .env and uncomment only the registries you want Tool Checker to enforce.
# Values may include authenticated URLs. The local .env file is ignored by Git.

# npm user registry
# NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

# pnpm global registry
# PNPM_CONFIG_REGISTRY=https://registry.npmjs.org/

# pip user package index
# PIP_INDEX_URL=https://pypi.org/simple/

# uv user default index
# UV_DEFAULT_INDEX=https://pypi.org/simple/

# NuGet source. NUGET_SOURCE_NAME defaults to nuget.org when omitted.
# NUGET_SOURCE_NAME=nuget.org
# NUGET_SOURCE_URL=https://api.nuget.org/v3/index.json
